[Unit]
Description=Tabi Plan debt repayment email reminders
After=network-online.target mysql.service
Wants=network-online.target mysql.service

[Service]
Type=oneshot
User=__APP_USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=__ENV_FILE__
ExecStart=/usr/bin/node __APP_DIR__/api/scripts/send-debt-reminders.mjs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=__APP_DIR__
