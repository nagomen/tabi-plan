# 旅行ダッシュボード API のリバースプロキシ。
#
# Vote の /etc/nginx/conf.d/vote.conf とは別ファイルにする。
# Vote の deploy.sh は vote.conf しか書き換えないので、こちらは巻き添えを受けない。
#
# 配置先: /etc/nginx/conf.d/travel-api.conf
#
# TLS は Cloudflare Origin Certificate を流用する。
# vote-jt.com の既存証明書が *.vote-jt.com を含んでいるため、
# サブドメインを増やしても certbot は不要（有効期限 2041 年）。
# Cloudflare が proxied で前段に居るので、ブラウザ向けの証明書は Cloudflare 側が出す。

server {
    listen 80;
    listen [::]:80;
    server_name __API_DOMAIN__;
    return 301 https://$host$request_uri;
}

server {
    # nginx 1.24 系なので `http2 on;` は使えない（1.25.1 以降の構文）。
    # Vote の vote.conf と同じ旧構文で揃える。
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __API_DOMAIN__;

    ssl_certificate     __SSL_CERT__;
    ssl_certificate_key __SSL_KEY__;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    # 共有ストアの JSON は最大 2MB を想定（API 側の MAX_BODY_BYTES と合わせる）
    client_max_body_size 4m;

    # Cloudflare からの接続に限り CF-Connecting-IP を本物の接続元として採用する。
    # これらの range 外（＝オリジンへ直接来た接続）が送ってきた CF-Connecting-IP は
    # 信用しない。これが無いと、Cloudflare を迂回した攻撃者が CF-Connecting-IP を
    # 毎回詐称してレート制限（ログイン総当たり対策を含む）を回避できてしまう。
    # 最新の一覧: https://www.cloudflare.com/ips/ （変更時はここを更新する）
    set_real_ip_from 173.245.48.0/20;
    set_real_ip_from 103.21.244.0/22;
    set_real_ip_from 103.22.200.0/22;
    set_real_ip_from 103.31.4.0/22;
    set_real_ip_from 141.101.64.0/18;
    set_real_ip_from 108.162.192.0/18;
    set_real_ip_from 190.93.240.0/20;
    set_real_ip_from 188.114.96.0/20;
    set_real_ip_from 197.234.240.0/22;
    set_real_ip_from 198.41.128.0/17;
    set_real_ip_from 162.158.0.0/15;
    set_real_ip_from 104.16.0.0/13;
    set_real_ip_from 104.24.0.0/14;
    set_real_ip_from 172.64.0.0/13;
    set_real_ip_from 131.0.72.0/22;
    set_real_ip_from 2400:cb00::/32;
    set_real_ip_from 2606:4700::/32;
    set_real_ip_from 2803:f800::/32;
    set_real_ip_from 2405:b500::/32;
    set_real_ip_from 2405:8100::/32;
    set_real_ip_from 2a06:98c0::/29;
    set_real_ip_from 2c0f:f248::/32;
    real_ip_header CF-Connecting-IP;

    # CORS は API 本体が Origin を見て付ける。ここでは付けない
    # （nginx でも付けるとヘッダが重複して全ブラウザが弾く）。
    location /api/ {
        proxy_pass http://127.0.0.1:__API_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # $remote_addr は real_ip 適用後の本物の接続元。Cloudflare 経由なら
        # 実訪問者 IP、直接接続なら攻撃者の実 IP になり、詐称値は入らない。
        # よって API 側の TRUST_CLOUDFLARE_CONNECTING_IP を有効化しても安全。
        proxy_set_header CF-Connecting-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # AI行程生成は API 側の OpenAI 期限（OPENAI_TIMEOUT_MS, 既定80s）まで応答に
        # かかる。ここが短いと nginx が先に切断し、CORS ヘッダの無い 504 が返って
        # ブラウザでは「接続できません」に見える。API の期限より長く、前段
        # Cloudflare の proxy 上限（約100s）より短くする。
        proxy_read_timeout 90s;
    }

    location = / {
        return 204;
    }

    location / {
        return 404;
    }
}
