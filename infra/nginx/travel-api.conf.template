# 旅行ダッシュボード API のリバースプロキシ。
#
# Vote の /etc/nginx/conf.d/vote.conf とは別ファイルにする。
# Vote の deploy.sh は vote.conf しか書き換えないので、こちらは巻き添えを受けない。
#
# 配置先: /etc/nginx/conf.d/travel-api.conf
#
# TLS は Cloudflare Origin Certificate を流用する。
# vote-jt.com の既存証明書が *.vote-jt.com を含んでいるため、
# サブドメインを増やしても certbot は不要（有効期限 2041 年）。
# Cloudflare が proxied で前段に居るので、ブラウザ向けの証明書は Cloudflare 側が出す。

server {
    listen 80;
    listen [::]:80;
    server_name __API_DOMAIN__;
    return 301 https://$host$request_uri;
}

server {
    # nginx 1.24 系なので `http2 on;` は使えない（1.25.1 以降の構文）。
    # Vote の vote.conf と同じ旧構文で揃える。
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __API_DOMAIN__;

    ssl_certificate     __SSL_CERT__;
    ssl_certificate_key __SSL_KEY__;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    # 共有ストアの JSON は最大 2MB を想定（API 側の MAX_BODY_BYTES と合わせる）
    client_max_body_size 4m;

    # CORS は API 本体が Origin を見て付ける。ここでは付けない
    # （nginx でも付けるとヘッダが重複して全ブラウザが弾く）。
    location /api/ {
        proxy_pass http://127.0.0.1:__API_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Cloudflare 経由なら CF-Connecting-IP を API 側で見られるように残す。
        # 直接アクセスでも rate limit が全員 127.0.0.1 扱いにならないよう、
        # X-Forwarded-For は通常の nginx チェーンを渡す。
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    location = / {
        return 204;
    }

    location / {
        return 404;
    }
}
