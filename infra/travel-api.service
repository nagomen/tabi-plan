[Unit]
Description=Tabi Plan shared-store API (travel dashboard)
Documentation=https://github.com/nagomen/tabi-plan
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=__APP_USER__
WorkingDirectory=__APP_DIR__
# 秘密情報はリポジトリではなくサーバー側に置く
EnvironmentFile=__ENV_FILE__
ExecStart=/usr/bin/node __APP_DIR__/api/dist/server.js
Restart=always
RestartSec=3
# server.ts 側が10秒で自主的に締めるので、systemd の既定90秒を待たない
TimeoutStopSec=15
# 起動直後に落ち続ける場合（設定ミス等）は再起動ループを止めてログに残す
StartLimitIntervalSec=60
StartLimitBurst=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=travel-api

# 最低限の隔離。Vote 側には一切触れない。
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=__APP_DIR__

[Install]
WantedBy=multi-user.target
