{
  "name": "tabi-plan",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "api"
  ],
  "scripts": {
    "dev": "npm run dev -w frontend",
    "build": "npm run build -w frontend",
    "preview": "npm run preview -w frontend",
    "typecheck": "npm run typecheck -w frontend && npm run typecheck -w backend && npm run typecheck -w api",
    "push": "npm run push -w backend",
    "deploy": "npm run deploy -w backend",
    "build:api": "npm run build -w api"
  }
}
