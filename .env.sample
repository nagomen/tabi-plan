# 旅行ダッシュボード API の設定（サーバー側専用）。
#
# このリポジトリのフロントは GitHub Pages で公開される。
# Vite は frontend/ 配下しかバンドルしないのでこの値がフロントに混ざることはないが、
# .env そのものは絶対にコミットしないこと（.gitignore 済み）。
#
# 使い方:
#   cp .env.sample .env  して値を埋める
#   本番は infra/deploy-api.sh がサーバー上の ~/secure_env/travel-api.env を読み込む

# ---- API プロセス --------------------------------------------------------
PORT=8001
HOST=127.0.0.1

# ---- データベース --------------------------------------------------------
# Vote と同じ MySQL サーバーの、別データベース（TravelPlan）を使う。
# MySQL は localhost バインドなので、
#   本番      : DB_HOST=127.0.0.1 / DB_PORT=3306（API も同じ VPS で動く）
#   ローカル開発: SSH トンネルを張って DB_PORT にその転送先ポートを指定する
#     ssh -N -L 3310:127.0.0.1:3306 ubuntu@163.44.121.146
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=TravelPlan
DB_USER=travelapp
DB_PASSWORD=

# ---- ローカル一括起動（npm run dev:full）-------------------------------
# DB_PORT が既にSSH転送済みなら既存接続を再利用する。
# LOCAL_DB_TUNNEL=0 にするとSSHを起動せず、DB_HOST/DB_PORTへ直接接続する。
LOCAL_DB_TUNNEL=1
LOCAL_DB_SSH_TARGET=ubuntu@163.44.121.146
LOCAL_DB_SSH_PORT=22
LOCAL_DB_REMOTE_HOST=127.0.0.1
LOCAL_DB_REMOTE_PORT=3306
# 現在のローカルAPIが必要とする後方互換DDLを起動前に冪等適用する。
LOCAL_DB_AUTO_MIGRATE=1
LOCAL_FRONTEND_PORT=5173

# ---- 認証 ---------------------------------------------------------------
# 静的サイトから呼ぶため、このトークンはブラウザから見える。
# 無差別スキャンを弾く程度の意味しかない。本物の権限管理ではない。
API_TOKEN=

# DB保存するセッショントークンのHMAC用。API_TOKENとは別の32文字以上のランダム値にする。
SESSION_SECRET=

# 漏えい時の影響を抑えるため既定は30日。利便性より安全性を優先する。
SESSION_TTL_DAYS=30

# このUnix時刻(ms)より前に発行した全セッションを無効化する。通常は0。
SESSION_EPOCH_MS=0

# ---- CORS ---------------------------------------------------------------
# フロントを配信しているオリジンをカンマ区切りで指定する。
ALLOWED_ORIGINS=https://rjajoo0414.github.io,http://localhost:5173

# ---- 上限 ---------------------------------------------------------------
MAX_BODY_BYTES=2097152
RATE_LIMIT_PER_MINUTE=240
AUTH_RATE_LIMIT_PER_MINUTE=10

# nginxがCloudflare以外から到達不能な場合だけtrueにする。
TRUST_CLOUDFLARE_CONNECTING_IP=false

# ---- AI（旅程の下書き） ----
# 未設定なら機能ごと無効（画面のボタンはエラーを返す）。
# キーはサーバーにだけ置く。静的サイトに出すと誰でも使えてしまう。
OPENAI_KEY=
# 省略時は gpt-5.4-mini。
OPENAI_MODEL=
# 生成の待ち時間の上限（ミリ秒）。省略時は 60000。
OPENAI_TIMEOUT_MS=

