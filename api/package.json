{
  "name": "tabi-plan-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:coverage": "npm run build && c8 --src src --all --reporter=text-summary --reporter=lcov --check-coverage --lines 40 --functions 54 --branches 64 node --test test/*.test.mjs",
    "migrate": "node scripts/migrate.mjs",
    "reencrypt-ai-credentials": "npm run build && node scripts/reencrypt-ai-credentials.mjs",
    "start": "node dist/server.js",
    "dev": "tsc --watch --preserveWatchOutput & node --watch dist/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tabi/contracts": "1.0.0",
    "express": "^5.2.1",
    "mysql2": "^3.11.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "c8": "^10.1.3",
    "typescript": "^5.5.4"
  }
}
