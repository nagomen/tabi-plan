# Dependencies
node_modules/

# Build output
frontend/dist/
frontend/.vite/
api/dist/

# clasp local config (per-developer Apps Script binding)
backend/.clasp.json
.clasprc.json

# 秘密情報（DB パスワード・API トークン）。
# このリポジトリのビルド成果物は GitHub Pages で公開されるため、
# .env を絶対にコミットしないこと。雛形は .env.sample を使う。
.env
.env.*
!.env.sample

# Logs / OS
*.log
.DS_Store

# Local agent/editor state
.claude/

# Domain data (future: DB)
# サーバーが無い間は、この JSON を git で配る＝本番の「配布用の種」になる。
# ビルド時に window.__DEV_PLANS__ / __DEV_STORE__ として HTML へ埋め込まれ、
# 訪問者の localStorage に流し込まれる（公開ページに載る点に注意）。
# ただし端末固有の状態は配らない。
data/store/trip-dashboard-user.json
