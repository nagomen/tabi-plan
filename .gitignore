# Dependencies
node_modules/

# Build output
frontend/dist/
frontend/.vite/
api/dist/

# 秘密情報（DB パスワード・API トークン）。
# このリポジトリのビルド成果物は GitHub Pages で公開されるため、
# .env を絶対にコミットしないこと。雛形は .env.sample を使う。
.env
.env.*
!.env.sample

# Logs / OS
*.log
.DS_Store

# Local agent/editor state
.claude/

# ローカル開発用のドメインデータ。
# 本番の正は MySQL（共有ストア API）なので、git で配らない。
# 手元では dev サーバーがここに読み書きし、DB への投入は
# ローカル開発ストアは Vite の開発用 API が必要に応じて作成する。
data/plans/*.json
data/store/*.json

# Test coverage output
api/coverage/
coverage/
